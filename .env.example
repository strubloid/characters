# OpenCode Zen API key, used by the Chat tab.
#
# 1. Create a key in the OpenCode Console: https://opencode.ai/console
# 2. Copy this file to `.env` (which is git-ignored) and paste the key in.
# 3. Restart `npm run dev`.
#
# The key stays on the server; it is never sent to the browser.
OPENCODE_ZEN_API_KEY=your_api_key_here

# Which OpenCode Zen plan the key belongs to. `go` (or `go-plus`, `go-teams`)
# points at https://opencode.ai/inference/go; anything else uses the
# pay-as-you-go root https://opencode.ai/inference.
OPENCODE_ZEN_PLAN=go

# Optional. Overrides the inference root entirely (takes precedence over
# OPENCODE_ZEN_PLAN). The chat URL and model list are derived from it.
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/inference

# Optional. Default model for the Chat tab; the picker can change it at any time.
# OPENCODE_ZEN_MODEL=big-pickle
