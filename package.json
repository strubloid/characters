{
  "name": "foundry-characters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Foundry VTT characters as reviewable source files.",
  "scripts": {
    "setup": "npm install --prefix app",
    "dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "app:lint": "npm --prefix app run lint",
    "app:typecheck": "npm --prefix app run typecheck",
    "app:test": "npm --prefix app run test",
    "build": "node tools/foundry.mjs build",
    "validate": "node tools/foundry.mjs validate",
    "render": "node tools/foundry.mjs render",
    "audit": "node tools/foundry.mjs audit",
    "check": "node tools/foundry.mjs check"
  },
  "engines": {
    "node": ">=18"
  }
}
